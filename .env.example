# ===== Sisi BROWSER (dibaca Vite, aman dipublikasikan) =====
# Kunci publik VAPID untuk Web Push. Buat dengan:  npm run vapid
VITE_VAPID_PUBLIC_KEY=""

# ===== Sisi SERVER (Vercel Environment Variables, RAHASIA) =====
VAPID_PUBLIC_KEY=""              # sama dengan VITE_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=""             # dari: npm run vapid
VAPID_SUBJECT="mailto:emailanda@contoh.com"

# JSON service account Firebase (Project settings > Service accounts > Generate new private key).
# Boleh ditempel mentah (satu baris) atau di-base64.
FIREBASE_SERVICE_ACCOUNT=""
FIRESTORE_DATABASE_ID="ai-studio-waktuibadah-0ce961ff-1426-47ab-83ff-c1e7525281b8"

# Rahasia untuk memanggil /api/cron/dispatch tiap menit. Buat string acak panjang (>= 32 karakter).
CRON_SECRET=""

# Token login Admin Dashboard (diperiksa di server, tidak lagi ada di kode). Pilih yang kuat.
ADMIN_TOKEN=""

# Bawaan AI Studio (tidak dipakai fitur notifikasi)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
