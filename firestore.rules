rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isValidPin(pin) {
      return pin == null || (pin is string && (pin.size() == 4 || pin == ''));
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Student Profiles (Multi-device sync based on student name and optional PIN)
    match /student_profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      
      allow create: if isValidId(profileId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && (!('pin' in request.resource.data) || isValidPin(request.resource.data.pin));

      allow update: if isValidId(profileId)
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100))
        && (
          !('pin' in resource.data) || 
          resource.data.pin == '' || 
          resource.data.pin == null ||
          !('pin' in request.resource.data) ||
          request.resource.data.pin == null ||
          request.resource.data.pin == resource.data.pin ||
          isValidPin(request.resource.data.pin)
        );

      allow delete: if isValidId(profileId); // Allowed for admin cleanup
    }

    // Website Reviews (Submitted by students, monitored in Admin Dashboard)
    match /website_reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;

      allow create: if isValidId(reviewId)
        && isNonEmptyString(request.resource.data.userName, 100)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow update: if false; // Reviews are immutable once submitted
      allow delete: if isValidId(reviewId); // Allowed for admin cleanup
    }

    // Admin Review Configuration (Global settings for website review / Google Form review)
    match /admin_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow write: if isValidId(configId)
        && request.resource.data.reviewMode in ['website', 'inapp', 'gform', 'both'];
    }

  }
}
